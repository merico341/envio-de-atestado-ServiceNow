        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
	if (current.data_de_nascimento != null) {
		let today = new GlideDate();

		let birth = new GlideDate();
		birth.setValue(current.data_de_nascimento);

		let age = parseInt(today.getByFormat("yyyy"), 10) - parseInt(birth.getByFormat("yyyy"), 10);

		today_month_day = parseInt(today.getByFormat("MMdd"));
		birth_month_day = parseInt(birth.getByFormat("MMdd"));

		if(today_month_day < birth_month_day) {
			age--;
		} 
		
		current.idade = age;
	}
})(current, previous);]]></script>
